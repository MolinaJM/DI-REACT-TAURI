// Canónico del curso (ver apuntes s03/09_Miscelánea §9.7): los proyectos hacen "extends" de este fichero.
{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2024", "ESNext", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  }
}
